<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= titulo %> · Emprendimiento</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <div class="topbar">
    <span class="topbar__msg">Alertas automáticas de licencias y vehículos</span>
    <nav class="topbar__links"><a href="#">Ayuda</a><a href="#">Mis pedidos</a></nav>
  </div>
  <header class="header">
    <a class="logo" href="/">emprendimiento</a>
