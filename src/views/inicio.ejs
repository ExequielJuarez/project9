<%- include('partials/head') %>
<%- include('partials/header') %>

<%
  // Los textos y fotos de la portada y el banner se editan desde Admin → Inicio
  // (ver src/data/inicioEditable.js). textoRico() escapa el texto y convierte *palabra* en cursiva.
  const c = contenido;
  const plano = (t) => String(t || "").replace(/\*/g, "");
%>

<main class="inicio">

  <!-- ═════════════ PORTADA ═════════════ -->
  <section class="portada-full" data-seccion="portada">
    <img class="portada-full__foto" src="<%= c.portada.imagen %>" alt="<%= plano(c.portada.titulo).replace(/\n/g, ' ') %>" fetchpriority="high">
    <div class="portada-full__velo"></div>
    <div class="portada-full__texto">
      <% if (c.portada.etiqueta) { %><p class="portada-full__etiqueta"><%- textoRico(c.portada.etiqueta) %></p><% } %>
      <h1 class="portada-full__titulo">
        <% c.portada.titulo.split("\n").forEach((renglon) => { %>
          <span><%- textoRico(renglon) %></span>
        <% }) %>
      </h1>
      <% if (c.portada.bajada) { %><p class="portada-full__bajada"><%- textoRico(c.portada.bajada) %></p><% } %>
      <div class="portada-full__acciones">
        <% if (c.portada.botonTexto) { %>
          <a href="<%= c.portada.botonLink || '/catalogo' %>" class="btn btn--solido"><%= c.portada.botonTexto %> <span aria-hidden="true">→</span></a>
        <% } %>
        <% if (c.portada.secundarioTexto) { %>
          <a href="<%= c.portada.secundarioLink || '#' %>" class="portada-full__secundario"><%= c.portada.secundarioTexto %></a>
        <% } %>
      </div>
    </div>
  </section>

  <!-- ═════════════ ELEGIDOS DE LA SEMANA ═════════════ -->
  <% if (elegidos.length) { %>
    <section class="elegidos contenedor" data-seccion="elegidos">
      <div class="elegidos__cabecera">
        <h2 class="elegidos__titulo" data-revelar>Elegidos de la semana</h2>
        <a href="/catalogo" class="elegidos__ver" data-revelar>Ver todo <span aria-hidden="true">→</span></a>
      </div>
      <div class="elegidos__grilla">
        <% elegidos.forEach((p, i) => { %>
          <%- include('partials/tarjeta', { p, i }) %>
        <% }) %>
      </div>
    </section>
  <% } %>

  <!-- ═════════════ BANNER ═════════════ -->
  <% if (c.banner.visible) { %>
    <section class="banner contenedor" data-seccion="banner">
      <a href="<%= c.banner.botonLink || '/catalogo' %>" class="banner__caja" data-revelar>
        <div class="banner__foto">
          <img src="<%= c.banner.imagen %>" alt="<%= plano(c.banner.titulo).replace(/\n/g, ' ') %>" loading="lazy">
        </div>
        <div class="banner__texto">
          <% if (c.banner.etiqueta) { %><p class="banner__etiqueta"><%= c.banner.etiqueta %></p><% } %>
          <h2 class="banner__titulo">
            <% c.banner.titulo.split("\n").forEach((renglon) => { %><span><%- textoRico(renglon) %></span><% }) %>
          </h2>
          <% if (c.banner.botonTexto) { %><span class="btn btn--solido"><%= c.banner.botonTexto %> <span aria-hidden="true">→</span></span><% } %>
        </div>
      </a>
    </section>
  <% } %>

</main>

<%- include('partials/footer') %>
<script src="/js/inicio.js"></script>
</body>
</html>
