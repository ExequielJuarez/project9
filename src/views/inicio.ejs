<%- include('partials/head') %>
<%- include('partials/header') %>

<%
  // Los textos y fotos de la portada, la cinta y el banner se editan desde Admin → Inicio
  // (ver src/data/inicioEditable.js). textoRico() escapa el texto y convierte *palabra* en cursiva.
  const c = contenido;
  const plano = (t) => String(t || "").replace(/\*/g, "");
  const categorias = [...new Set(elegidos.map((p) => p.categoria))];
  const miniaturas = elegidos.slice(0, 3);
%>

<main class="inicio">

  <!-- ═════════════ PORTADA ═════════════ -->
  <section class="apertura" data-seccion="portada">
    <img class="apertura__foto" src="<%= c.portada.imagen %>" alt="<%= plano(c.portada.titulo).replace(/\n/g, ' ') %>" fetchpriority="high">
    <div class="apertura__velo"></div>

    <div class="apertura__texto">
      <% if (c.portada.etiqueta) { %><p class="apertura__etiqueta"><%- textoRico(c.portada.etiqueta) %></p><% } %>
      <h1 class="apertura__titulo">
        <% c.portada.titulo.split("\n").forEach((renglon) => { %><span><%- textoRico(renglon) %></span><% }) %>
      </h1>
      <% if (c.portada.bajada) { %><p class="apertura__bajada"><%- textoRico(c.portada.bajada) %></p><% } %>
      <% if (c.portada.botonTexto) { %>
        <a href="<%= c.portada.botonLink || '/catalogo' %>" class="btn btn--tan"><%= c.portada.botonTexto %> <span aria-hidden="true">→</span></a>
      <% } %>
    </div>

    <% if (miniaturas.length) { %>
      <div class="apertura__riel" aria-label="Productos destacados">
        <p class="apertura__riel-num">01 <i></i> <%= String(miniaturas.length).padStart(2, '0') %></p>
        <% miniaturas.forEach((p) => { %>
          <a href="/producto/<%= p.id %>" class="apertura__mini">
            <span class="apertura__mini-foto"><% if (p.imagen) { %><img src="<%= p.imagen %>" alt="" loading="lazy"><% } %></span>
            <span class="apertura__mini-nombre"><%= p.nombre %></span>
            <span class="apertura__mini-precio"><%= formatoPrecio(p.precio) %></span>
          </a>
        <% }) %>
      </div>
    <% } %>
  </section>

  <!-- ═════════════ ELEGIDOS DE LA SEMANA ═════════════ -->
  <% if (elegidos.length) { %>
    <section class="elegidos contenedor" data-seccion="elegidos">
      <div class="elegidos__cabecera">
        <div>
          <p class="sobretitulo" data-revelar>La colección</p>
          <h2 class="elegidos__titulo" data-revelar>Elegidos de la semana</h2>
        </div>
        <a href="/catalogo" class="elegidos__ver" data-revelar>Ver todo <span aria-hidden="true">→</span></a>
      </div>

      <% if (categorias.length > 1) { %>
        <div class="pastillas" role="tablist" aria-label="Categorías" id="pastillasInicio">
          <button type="button" class="pastilla activa" data-categoria="" role="tab" aria-selected="true">Todo</button>
          <% categorias.forEach((cat) => { %>
            <button type="button" class="pastilla" data-categoria="<%= cat %>" role="tab" aria-selected="false"><%= cat %></button>
          <% }) %>
        </div>
      <% } %>

      <div class="elegidos__grilla" id="elegidosGrilla">
        <% elegidos.forEach((p, i) => { %>
          <%- include('partials/tarjeta', { p, i }) %>
        <% }) %>
      </div>
    </section>
  <% } %>

  <!-- ═════════════ CINTA ═════════════ -->
  <% if (c.cinta.visible && c.cinta.palabras) { %>
    <div class="cinta" aria-hidden="true" data-seccion="cinta">
      <div class="cinta__pista">
        <% for (let vuelta = 0; vuelta < 2; vuelta++) { %>
          <% c.cinta.palabras.split("\n").forEach((frase) => { %><span><%= frase %></span><i>✦</i><% }) %>
        <% } %>
      </div>
    </div>
  <% } %>

  <!-- ═════════════ BANNER ═════════════ -->
  <% if (c.banner.visible) { %>
    <section class="banner contenedor" data-seccion="banner">
      <a href="<%= c.banner.botonLink || '/catalogo' %>" class="banner__caja" data-revelar>
        <div class="banner__foto">
          <img src="<%= c.banner.imagen %>" alt="<%= plano(c.banner.titulo).replace(/\n/g, ' ') %>" loading="lazy">
        </div>
        <div class="banner__texto">
          <% if (c.banner.etiqueta) { %><p class="banner__etiqueta"><%= c.banner.etiqueta %></p><% } %>
          <h2 class="banner__titulo">
            <% c.banner.titulo.split("\n").forEach((renglon) => { %><span><%- textoRico(renglon) %></span><% }) %>
          </h2>
          <% if (c.banner.botonTexto) { %><span class="btn btn--tan"><%= c.banner.botonTexto %> <span aria-hidden="true">→</span></span><% } %>
        </div>
      </a>
    </section>
  <% } %>

</main>

<%- include('partials/footer') %>
<script src="/js/inicio.js"></script>
</body>
</html>
